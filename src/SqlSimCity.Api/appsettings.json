{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "HttpSecurity": {
    "MaxRequestBodyBytes": 65536,
    "ApiPermitLimit": 600,
    "ApiWindowSeconds": 60
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": "",
    "KnownNetworks": "",
    "ForwardLimit": 1
  },
  "Acquisition": {
    "Mode": "Fixture",
    "Archive": {
      "AllowedDirectory": "/archives",
      "FileName": "sqlsimcity.ssca",
      "MaximumArchiveBytes": 268435456
    }
  },
  "Atlas": {
    "Mode": "Fixture",
    "TargetId": "primary",
    "DisplayName": "SQL Server",
    "DatabaseConcurrency": 4,
    "RefreshIntervalSeconds": 60,
    "QueryStoreRefreshIntervalSeconds": 900,
    "StaleAfterSeconds": 180,
    "QueryStoreWindowMinutes": 1440,
    "KnownDatabases": []
  },
  "QueryStoreHistory": {
    "Mode": "Fixture",
    "PageSize": 1000,
    "DatabaseConcurrency": 4,
    "OverlapMinutes": 65,
    "InitialLookbackDays": 90,
    "RefreshIntervalSeconds": 120,
    "MaximumBackoffMinutes": 15,
    "PlanCacheQuotaBytes": 2147483648
  },
  "ProtectedStorage": {
    "Enabled": false,
    "DataDirectory": "/data",
    "DatabaseFileName": "protected-storage.db"
  }
}
