<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Data.SqlClient 7 removed Azure.Core/Azure.Identity from its core
      package (see the 7.0 release notes). This project uses SqlConnection's
      explicit AccessTokenCallback with its own Azure.Identity credential
      selection (see EntraTokenCredentialFactory) rather than the connection
      string `Authentication=Active Directory ...` modes, so it does not need
      Microsoft.Data.SqlClient.Extensions.Azure; Azure.Identity/Azure.Core are
      referenced directly instead, and only for that purpose.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlSimCity.SqlServer.Tests" />
  </ItemGroup>

</Project>
